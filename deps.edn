;; GHOST HACKER: VAMOS A BAILAR -- pure .cljc full-cast party minigame
;; core (ADR-2607023200, portfolio title #9). No shared-lib dependency
;; (unlike FLOW/HARMONY's ghosthacker-groove-core) -- VAMOS A BAILAR's
;; judgment models (numeric closeness / binary pick / sequence-position
;; match) are independent of the rhythm titles' beat-grid timing model.
{:paths ["src"]

 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.09.27"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"]}
  :kotoba {:extra-deps {io.github.kotoba-lang/amu
                        {:git/url "https://github.com/kotoba-lang/amu.git"
                         :git/sha "def5161be96d489539175813326a316da46268be"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}
  ;; Browser host adapter (ADR-2607100900 follow-up (b)): plain reagent,
  ;; no Web Audio needed -- VAMOS A BAILAR is entirely click-driven
  ;; (pass-the-device party UX), same low-complexity end of the host
  ;; spectrum as ECHOES/TUNING.
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      reagent/reagent           {:mvn/version "1.2.0"}
                      thheller/shadow-cljs      {:mvn/version "2.28.20"}}}}}
